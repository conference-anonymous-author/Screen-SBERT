# Triton server ports (server container)
TRITON_HTTP_PORT=4000
TRITON_GRPC_PORT=4001
TRITON_METRICS_PORT=4002

# gRPC URL for the Triton Inference Server (host:port)
# Examples: "localhost:4001", "gui_parser_server:4001", "192.168.x.x:4001"
# Must match TRITON_GRPC_PORT above.
TRITON_GRPC_URL=gui_parser_server:4001

# Proxy published/bind ports (proxy container)
PROXY_HOST_PORT=4023
PROXY_CONTAINER_PORT=4023
